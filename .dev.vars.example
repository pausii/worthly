# Salin file ini menjadi `.dev.vars` untuk pengembangan lokal (`wrangler dev`).
# JANGAN commit file `.dev.vars` yang asli.

# Kunci master enkripsi kredensial (AES-GCM 256). Wajib 32 byte di-base64.
# Cara generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
# atau (Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY="ganti-dengan-base64-32-byte-acak"

# Opsional: API key CoinGecko (kalau pakai endpoint berbayar). Kosongkan kalau pakai gratis.
COINGECKO_API_KEY=""

# Opsional: endpoint RPC default (boleh juga diisi per-account lewat UI).
# EVM = Alchemy, TRON = TronGrid, Solana = JSON-RPC apa pun (Helius/QuickNode/Alchemy).
# RPC_SOL_URL sangat disarankan diisi (mis. Helius): api.mainnet-beta.solana.com memblokir IP
# Cloudflare Workers, dan endpoint publik cadangan sering kena rate-limit (429).
RPC_ETH_URL=""
RPC_BSC_URL=""
RPC_TRON_URL=""
RPC_TRON_API_KEY=""
RPC_SOL_URL=""

# Opsional: password proteksi untuk membuka konsol GraphiQL (/graphql)
GRAPHIQL_PASSWORD=""
