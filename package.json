{
  "name": "worthly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-frontend.mjs",
    "dev": "node scripts/build-frontend.mjs && wrangler dev",
    "deploy": "node scripts/build-frontend.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create wallet_db",
    "kv:create": "wrangler kv namespace create KV",
    "db:migrate:local": "wrangler d1 migrations apply wallet_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wallet_db --remote",
    "db:console:local": "wrangler d1 execute wallet_db --local --command"
  },
  "dependencies": {
    "apexcharts": "^5.13.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250520.0",
    "alpinejs": "^3.14.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.0"
  }
}
